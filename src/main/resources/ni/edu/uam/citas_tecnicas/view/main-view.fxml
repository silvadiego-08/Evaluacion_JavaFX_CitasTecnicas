<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<BorderPane minHeight="600.0" minWidth="900.0" prefHeight="700.0" prefWidth="1100.0" styleClass="ventana-principal" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="encabezado">
            <StackPane styleClass="logo">
                <Label styleClass="logo-texto" text="CT" />
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label styleClass="titulo-app" text="Citas Técnicas" />
                <Label styleClass="subtitulo-app" text="Gestión de clientes y citas de servicio técnico" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <TabPane styleClass="tabs-principal" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Clientes">
                <content>

                    <fx:include source="cliente-view.fxml"/>
                </content>
            </Tab>
            <Tab text="Citas técnicas">
                <content>

                    <fx:include source="cita-view.fxml"/>
                </content>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="barra-estado">
            <Region HBox.hgrow="ALWAYS" />
            <Label text="JavaFX · PostgreSQL · JDBC" />
        </HBox>
    </bottom>
</BorderPane>
