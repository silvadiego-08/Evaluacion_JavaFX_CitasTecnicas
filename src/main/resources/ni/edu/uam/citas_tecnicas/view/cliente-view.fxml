<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" stylesheets="@../css/styles.css" styleClass="root-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.citas_tecnicas.controller.ClienteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título de la sección -->
    <Label text="Gestión de Clientes" styleClass="section-title" />

    <!-- Formulario de Registro / Edición -->
    <VBox spacing="12.0" styleClass="form-card">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>

        <HBox spacing="15.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Nombres" styleClass="field-label" />
                <TextField fx:id="txtNombres" promptText="Ingrese nombres" styleClass="text-field-custom" />
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Apellidos" styleClass="field-label" />
                <TextField fx:id="txtApellidos" promptText="Ingrese apellidos" styleClass="text-field-custom" />
            </VBox>
        </HBox>

        <HBox spacing="15.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Teléfono" styleClass="field-label" />
                <TextField fx:id="txtTelefono" promptText="Ingrese teléfono" styleClass="text-field-custom" />
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label text="Correo Electrónico" styleClass="field-label" />
                <TextField fx:id="txtCorreo" promptText="Ingrese correo electrónico" styleClass="text-field-custom" />
            </VBox>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <CheckBox fx:id="chkActivo" text="Cliente Activo" styleClass="check-box-custom" />
        </HBox>
    </VBox>

    <!-- Botones de Acción CRUD (Uniformados) -->
    <HBox spacing="10.0">
        <Button fx:id="btnNuevo" text="Nuevo" onAction="#handleNuevo" styleClass="btn-action-secondary" />
        <Button fx:id="btnGuardar" text="Guardar" onAction="#handleGuardar" styleClass="btn-action-primary" />
        <Button fx:id="btnActualizar" text="Actualizar" onAction="#handleActualizar" styleClass="btn-action-primary" />
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" styleClass="btn-action-danger" />
        <Button fx:id="btnLimpiar" text="Limpiar" onAction="#handleLimpiar" styleClass="btn-action-secondary" />
    </HBox>

    <!-- Barra de Búsqueda -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, apellido o correo..." styleClass="text-field-custom" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnBuscar" text="Buscar" onAction="#handleBuscar" styleClass="btn-action-primary" />
    </HBox>

    <!-- TableView de Clientes -->
    <TableView fx:id="tableClientes" styleClass="table-view-custom" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60.0" />
            <TableColumn fx:id="colNombres" text="Nombres" prefWidth="130.0" />
            <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="130.0" />
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110.0" />
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="200.0" />
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="80.0" />
        </columns>
    </TableView>
</VBox>